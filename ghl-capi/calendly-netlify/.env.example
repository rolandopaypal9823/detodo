# GHL: Settings > Private Integrations (scopes: contacts.readonly, contacts.write)
GHL_API_TOKEN=pit-xxxxxxxx
# GHL: Settings > Business Profile
GHL_LOCATION_ID=xxxxxxxxxxxxxxxx
# Tag que dispara el workflow de Meta CAPI (trigger gratuito "Contact Tag")
GHL_TAG_AGENDO=agendo
GHL_TAG_CANCELO=cancelo_agenda
# Key del custom field donde guardas el fbclid
GHL_FIELD_FBCLID=fbclid
# Dominio permitido para el POST desde la thank you page (* = cualquiera)
ALLOWED_ORIGIN=*
# Opcional: solo si mas adelante das de alta el webhook real de Calendly
CALENDLY_SIGNING_KEY=
