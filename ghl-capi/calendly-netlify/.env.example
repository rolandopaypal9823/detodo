# Token de Private Integration de GHL (Settings > Private Integrations)
# Scopes necesarios: contacts.readonly, contacts.write
GHL_API_TOKEN=pit-xxxxxxxx
# Settings > Business Profile > Location ID
GHL_LOCATION_ID=xxxxxxxxxxxxxxxx
# Tag que dispara el workflow "CAPI Agenda"
GHL_TAG_AGENDO=agendo
# Tag opcional para cancelaciones
GHL_TAG_CANCELO=cancelo_agenda
# Key de un custom field (texto) para guardar la fecha de la cita. Dejar vacio para no usar.
GHL_FIELD_FECHA_AGENDA=
# Signing key que definis al crear el webhook en Calendly. Dejar vacio para no verificar.
CALENDLY_SIGNING_KEY=
