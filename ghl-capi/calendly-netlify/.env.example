# --- Calendly (siempre) ---
# Signing key que vos inventas al crear el webhook de Calendly (paso 3 del README).
CALENDLY_SIGNING_KEY=

# --- Modo A: recomendado, sin token de GHL ---
# URL del trigger "Inbound Webhook" de tu workflow en GHL.
GHL_INBOUND_WEBHOOK_URL=

# --- Modo B: respaldo, solo si tu plan de GHL no tiene Inbound Webhook trigger ---
# Dejar todo esto vacio si usas el Modo A.
GHL_API_TOKEN=
GHL_LOCATION_ID=
GHL_TAG_AGENDO=agendo
GHL_TAG_CANCELO=cancelo_agenda
GHL_FIELD_FECHA_AGENDA=
